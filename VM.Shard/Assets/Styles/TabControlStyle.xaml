<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ModuleListHorTabControl" TargetType="TabControl">
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid
                        x:Name="templateRoot"
                        ClipToBounds="true"
                        KeyboardNavigation.TabNavigation="Local"
                        SnapsToDevicePixels="true">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Border Height="35">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Microsoft YaHei"
                                        Text="模块列表" />
                                </Border>
                                <ScrollViewer
                                    Grid.Row="1"
                                    CanContentScroll="True"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden">
                                    <TabPanel
                                        x:Name="headerPanel"
                                        Margin="5"
                                        Panel.ZIndex="0"
                                        Background="Transparent"
                                        IsItemsHost="true"
                                        KeyboardNavigation.TabIndex="1" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Border
                            x:Name="contentPanel"
                            Grid.Column="1"
                            Background="Transparent"
                            KeyboardNavigation.DirectionalNavigation="Contained"
                            KeyboardNavigation.TabIndex="2"
                            KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                Margin="{TemplateBinding Padding}"
                                ContentSource="SelectedContent"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ModuleListVerTabItem" TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border
                        Name="back"
                        Height="40"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0,0,3,0"
                        Cursor="Hand">
                        <StackPanel
                            Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Grid}}, Path=Width}"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Image
                                Width="22"
                                Height="22"
                                Margin="5,0"
                                Source="{Binding IconImage}" />
                            <Grid>
                                <StackPanel Grid.Row="0" Orientation="Vertical">
                                    <TextBlock Margin="0" VerticalAlignment="Center">
                                        <Run Foreground="White" Text="{Binding ModuleNo}" />
                                        <Run Foreground="White" Text="." />
                                        <Run Foreground="White" Text="{Binding DisplayName}" />
                                    </TextBlock>
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Foreground="Lime"
                                        Text="{Binding Remarks, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!--<ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource  MahApps.Brushes.AccentBase}" TargetName="back"/>
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent2}" TargetName="back"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>