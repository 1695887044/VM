<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cs="clr-namespace:DemoThemes.ThemeCs">
    <Style TargetType="cs:LabelLinkPath">
        <Setter Property="Width" Value="360" />
        <Setter Property="Height" Value="45" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="cs:LabelLinkPath">
                    <Border
                        Width="360"
                        Height="45"
                        Padding="8,6"
                        Background="#E5E7EB"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="8">
                        <DockPanel LastChildFill="True">
                            <TextBlock
                                Name="PART_HeadTextBlock"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#666"
                                Text="{TemplateBinding Header}" />
                            <StackPanel
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal">
                                <Button
                                    Name="PART_LinkButton"
                                    Width="36"
                                    Height="36"
                                    Margin="8,2,0,2"
                                    Background="#F3F4F6"
                                    Content="🔗"
                                    ToolTip="链接" />
                                <Button
                                    Name="PART_ClearButton"
                                    Width="36"
                                    Height="36"
                                    Margin="2"
                                    Background="#F3F4F6"
                                    Content="X"
                                    ToolTip="清空" />
                            </StackPanel>
                            <TextBox
                                Name="PART_ContentBox"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#333"
                                IsReadOnly="True"
                                Text="/user/documents/project/file.txt" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>