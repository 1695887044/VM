<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:cs="clr-namespace:DemoThemes.ThemeCs">
    <Style TargetType="cs:LabelLinkPath">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="cs:LabelLinkPath">
                    <Border
                        Padding="8,6"
                        Background="#E5E7EB"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid Height="35">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Name="PART_HeadTextBlock"
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#666"
                                Text="{TemplateBinding Header}" />
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Name="PART_LinkButton"
                                    Width="30"
                                    Height="30"
                                    Padding="2"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="🔗"
                                    FontFamily="Segoe UI Emoji"
                                    ToolTip="链接" />
                                <!--  新增：指定支持Emoji的字体  -->
                                <Button
                                    Name="PART_ClearButton"
                                    Width="16"
                                    Height="16"
                                    Margin="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="X"
                                    ToolTip="清空" />
                            </StackPanel>
                            <TextBox
                                Name="PART_ContentBox"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="10"
                                Foreground="#333" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>