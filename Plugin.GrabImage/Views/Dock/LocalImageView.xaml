<UserControl
    x:Class="Plugin.GrabImage.Views.Dock.LocalImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Plugin.GrabImage.Views.Dock"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="350"
    d:DesignWidth="400"
    Background="White"
    mc:Ignorable="d">
    <GroupBox Grid.Row="1" Header="指定图像">
        <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Button
                    Margin="20"
                    Command="{Binding SelectImageCommand}"
                    Content="选择文件" />
            </StackPanel>
            <hc:TextBox
                Width="300"
                HorizontalAlignment="Left"
                hc:InfoElement.TitlePlacement="Top"
                hc:InfoElement.TitleWidth="60"
                hc:TitleElement.Title="路径："
                IsReadOnly="True"
                Text="{Binding ImageSourcePath}"
                TextWrapping="WrapWithOverflow" />
        </StackPanel>
    </GroupBox>
</UserControl>
