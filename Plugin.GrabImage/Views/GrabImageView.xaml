<UserControl
    x:Class="Plugin.GrabImage.Views.GrabImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:halcon="http://schemas.mvtec.com/halcondotnet"
    xmlns:halconCt="clr-namespace:VM.Halcon.Controls;assembly=VM.Halcon"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Plugin.GrabImage.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:Plugin.GrabImage.ViewModels"
    xmlns:views="clr-namespace:Plugin.GrabImage.Views.Dock"
    Width="980"
    Height="680"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <ResourceDictionary Source="/Plugin.GrabImage;component/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
       
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:TabControl
            hc:IconElement.Height="16"
            hc:IconElement.Width="16"
            IsAnimationEnabled="True"
            IsTabFillEnabled="True">
            <hc:TabItem hc:IconElement.Geometry="{StaticResource PageModeGeometry}" Header="基本参数">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <hc:Card Header="采集模式" Style="{StaticResource InputElementBaseStyle}">
                        <UniformGrid Columns="3">
                            <RadioButton
                                hc:IconElement.Geometry="{StaticResource 指定}"
                                Command="{Binding ChangeModeCommand}"
                                CommandParameter="1"
                                Content="指定图像"
                                IsChecked="True"
                                Style="{StaticResource RadioButtonIcon}" />
                            <RadioButton
                                hc:IconElement.Geometry="{StaticResource 目录}"
                                Command="{Binding ChangeModeCommand}"
                                CommandParameter="2"
                                Content="文件目录"
                                Style="{StaticResource RadioButtonIcon}" />
                            <RadioButton
                                hc:IconElement.Geometry="{StaticResource 采集}"
                                Command="{Binding ChangeModeCommand}"
                                CommandParameter="3"
                                Content="相机采集"
                                Style="{StaticResource RadioButtonIcon}" />
                        </UniformGrid>
                    </hc:Card>
                    <ContentControl Grid.Row="1" Content="{Binding GrabViewModel }">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vms:LocalImageViewModel}">
                                <views:LocalImageView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vms:DirectoryGrabViewModel}">
                                <views:DirectoryGrabView/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Grid>
            </hc:TabItem>
        </hc:TabControl>
        <halconCt:ImageEdit Grid.Column="1" HImage="{Binding DisplayImage}" />

    </Grid>
</UserControl>
