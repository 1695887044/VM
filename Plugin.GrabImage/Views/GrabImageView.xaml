<UserControl
    x:Class="Plugin.GrabImage.Views.GrabImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:halcon="http://schemas.mvtec.com/halcondotnet"
    xmlns:halconCt="clr-namespace:VM.Halcon.Controls;assembly=VM.Halcon"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Plugin.GrabImage.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="980"
    Height="680"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <ResourceDictionary Source="/Plugin.GrabImage;component/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:TabControl
            hc:IconElement.Height="16"
            hc:IconElement.Width="16"
            IsAnimationEnabled="True"
            IsTabFillEnabled="True">
            <hc:TabItem hc:IconElement.Geometry="{StaticResource PageModeGeometry}" Header="基本参数">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <GroupBox Header="采集模式">
                        <UniformGrid Columns="3">
                            <RadioButton
                                hc:IconElement.Geometry="{StaticResource 指定}"
                                Content="指定图像"
                                IsChecked="True"
                                Style="{StaticResource RadioButtonIcon}" />
                            <RadioButton
                                hc:IconElement.Geometry="{StaticResource 目录}"
                                Content="文件目录"
                                Style="{StaticResource RadioButtonIcon}" />
                            <RadioButton
                                hc:IconElement.Geometry="{StaticResource 采集}"
                                Content="相机采集"
                                Style="{StaticResource RadioButtonIcon}" />
                        </UniformGrid>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="指定图像">
                        <StackPanel
                            Margin="0,100,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Vertical">
                            <StackPanel Margin="0,-130,0,0" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,30,0"
                                    hc:IconElement.Geometry="{StaticResource 选择}"
                                    Command="{Binding SelectImageCommand}"
                                    Content="选择文件" />
                                <Button
                                    hc:IconElement.Geometry="{StaticResource 链接}"
                                    Command="{Binding LinkViewCommand}"
                                    Content="链接路径" />
                            </StackPanel>
                            <hc:TextBox
                                hc:InfoElement.TitlePlacement="Top"
                                hc:InfoElement.TitleWidth="60"
                                hc:TitleElement.Title="路径："
                                IsReadOnly="True"
                                Text="{Binding ImageSourcePath.Value}"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </hc:TabItem>
            <hc:TabItem hc:IconElement.Geometry="{StaticResource TwoPageModeGeometry}" Header="图像参数">
                <GroupBox Header="图像参数" />
            </hc:TabItem>
        </hc:TabControl>
        <halconCt:ImageEdit Grid.Column="1" HImage="{Binding DisplayImage}" />

    </Grid>
</UserControl>
