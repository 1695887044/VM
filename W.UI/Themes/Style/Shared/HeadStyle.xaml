<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvts="clr-namespace:W.UI.Core.Converters"
    xmlns:local="clr-namespace:W.UI.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/W.UI;component/Themes/Basic/Geometry.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="HeadIcon" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="2,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="{Binding Path=(local:IconElement.IconSize), RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="Text" Value="{Binding Path=(local:IconElement.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={cvts:StringToVisibilityConverter}}" />
    </Style>
    <Style x:Key="HeadTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="Text" Value="{Binding Path=(local:TitleElement.Title), RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={cvts:StringToVisibilityConverter}}" />
    </Style>
    <Style x:Key="watermark" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Foreground" Value="#999" />
        <Setter Property="Text" Value="{Binding Path=(local:InfoElement.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="Visibility" Value="Collapsed" />

        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}, Converter={cvts:StringNotNullToBoolConverter}}" Value="True" />

                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
                </MultiDataTrigger.Conditions>

                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}, Converter={cvts:StringNotNullToBoolConverter}}" Value="True" />
                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>

    </Style>
    <Style x:Key="ClearButton" TargetType="{x:Type Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Foreground" Value="#999" />
        <Setter Property="Margin" Value="5,0,5,0" />
        <Setter Property="Command" Value="{x:Static local:InfoElementExt.ClearCommand}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <Path x:Name="PathIcon"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          Fill="{TemplateBinding Foreground}"
                          Data="{StaticResource M.G.Close2}" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(local:InfoElement.ShowClearButton), RelativeSource={RelativeSource AncestorType=TextBox}}" Value="True" />
                    <Condition Binding="{Binding Path=Text, RelativeSource={RelativeSource AncestorType=TextBox}, Converter={cvts:StringNotNullToBoolConverter}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#E81123" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>