<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:W.UI.Controls">
    <Storyboard x:Key="Anim.Pulse">
        <DoubleAnimation
            AutoReverse="True"
            RepeatBehavior="Forever"
            Storyboard.TargetProperty="Opacity"
            From="1.0"
            To="0.4"
            Duration="0:0:0.8" />
    </Storyboard>

    <Style TargetType="{x:Type local:StatusIndicator}">
        <Setter Property="local:InfoElement.ContentHeight" Value="24" />
        <Setter Property="local:TitleElement.TitlePlacement" Value="Bottom" />
        <Setter Property="local:TitleElement.Foreground" Value="#333333" />
        <Setter Property="ActiveBrush" Value="#00C853" />
        <Setter Property="InactiveBrush" Value="#CFD8DC" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StatusIndicator}">
                    <Grid x:Name="RootGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="Col0" Width="Auto" />
                            <ColumnDefinition x:Name="Col1" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="Row0" Height="Auto" />
                            <RowDefinition x:Name="Row1" Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="TitlePart"
                            Margin="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{Binding Path=(local:TitleElement.Foreground), RelativeSource={RelativeSource TemplatedParent}}"
                            Text="{Binding Path=(local:TitleElement.Title), RelativeSource={RelativeSource TemplatedParent}}" />

                        <Grid
                            x:Name="IndicatorPart"
                            Width="{Binding Path=(local:InfoElement.ContentHeight), RelativeSource={RelativeSource TemplatedParent}}"
                            Height="{Binding Path=(local:InfoElement.ContentHeight), RelativeSource={RelativeSource TemplatedParent}}">

                            <Ellipse
                                x:Name="Glow"
                                Fill="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                Opacity="0">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="6" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <Border
                                x:Name="CoreShape"
                                Background="{Binding InactiveBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid>
                                    <Path
                                        x:Name="GlassReflection"
                                        Margin="3"
                                        Data="M 2,5 A 10,10 0 0 1 15,2"
                                        IsHitTestVisible="False"
                                        Opacity="0.3"
                                        Stretch="Uniform"
                                        Stroke="White"
                                        StrokeThickness="1.5" />

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="{Binding Path=(local:IconElement.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                        Foreground="White"
                                        Text="{Binding Path=(local:IconElement.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextBlock.FontSize="10"
                                        TextBlock.Foreground="White" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="CoreShape" Property="Background" Value="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.7" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsActive" Value="True" />
                                <Condition Property="IsPulsing" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="PulsingStory">
                                    <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="IndicatorPart"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1"
                                            To="0.4"
                                            Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulsingStory" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="CornerRadius" Value="0">
                            <Setter TargetName="CoreShape" Property="CornerRadius" Value="100" />
                        </Trigger>

                        <Trigger Property="local:TitleElement.TitlePlacement" Value="Bottom">
                            <Setter TargetName="IndicatorPart" Property="Grid.Row" Value="0" />
                            <Setter TargetName="TitlePart" Property="Grid.Row" Value="1" />
                        </Trigger>
                        <Trigger Property="local:TitleElement.TitlePlacement" Value="Top">
                            <Setter TargetName="TitlePart" Property="Grid.Row" Value="0" />
                            <Setter TargetName="IndicatorPart" Property="Grid.Row" Value="1" />
                        </Trigger>
                        <Trigger Property="local:TitleElement.TitlePlacement" Value="Left">
                            <Setter TargetName="TitlePart" Property="Grid.Column" Value="0" />
                            <Setter TargetName="IndicatorPart" Property="Grid.Column" Value="1" />
                            <Setter TargetName="TitlePart" Property="Margin" Value="0,0,5,0" />
                        </Trigger>
                        <Trigger Property="local:TitleElement.TitlePlacement" Value="Right">
                            <Setter TargetName="IndicatorPart" Property="Grid.Column" Value="0" />
                            <Setter TargetName="TitlePart" Property="Grid.Column" Value="1" />
                            <Setter TargetName="TitlePart" Property="Margin" Value="5,0,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Status.NeonBar" TargetType="{x:Type local:StatusIndicator}">
        <Setter Property="local:InfoElement.ContentHeight" Value="6" />
        <Setter Property="local:TitleElement.TitlePlacement" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StatusIndicator}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Path=(local:IconElement.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                    FontFamily="Segoe Fluent Icons" Margin="0,0,4,0" VerticalAlignment="Center"
                                    Foreground="{Binding Path=(local:TitleElement.Foreground), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <TextBlock Text="{Binding Path=(local:TitleElement.Title), RelativeSource={RelativeSource TemplatedParent}}"
                                    Foreground="{Binding Path=(local:TitleElement.Foreground), RelativeSource={RelativeSource TemplatedParent}}"/>
                        </StackPanel>

                        <Grid>
                            <Border Background="#1A000000" Height="{Binding Path=(local:InfoElement.ContentHeight), RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="3" />
                            <Border x:Name="ActiveBar" Width="0" HorizontalAlignment="Left"
                                Background="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                Height="{Binding Path=(local:InfoElement.ContentHeight), RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="3">
                                <Border.Effect>
                                    <BlurEffect x:Name="BarGlow" Radius="0" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveBar" Storyboard.TargetProperty="Width" To="100" Duration="0:0:0.4" />
                                        <DoubleAnimation Storyboard.TargetName="BarGlow" Storyboard.TargetProperty="Radius" To="8" Duration="0:0:0.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveBar" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Status.RingGauge" TargetType="{x:Type local:StatusIndicator}">
        <Setter Property="local:InfoElement.ContentHeight" Value="48" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StatusIndicator}">
                    <Grid Width="{Binding Path=(local:InfoElement.ContentHeight), RelativeSource={RelativeSource TemplatedParent}}"
                      Height="{Binding Path=(local:InfoElement.ContentHeight), RelativeSource={RelativeSource TemplatedParent}}">
                        <Ellipse Stroke="{Binding InactiveBrush, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="3" Opacity="0.2"/>
                        <Ellipse x:Name="ActiveRing" Stroke="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}" 
                             StrokeThickness="3" StrokeDashArray="100,100" StrokeDashOffset="100" Opacity="0">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90" CenterX="24" CenterY="24"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Path=(local:IconElement.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                   FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center"
                                   FontSize="{Binding Path=(local:IconElement.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter />
                        </StackPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="ActiveRing" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveRing" Storyboard.TargetProperty="StrokeDashOffset" To="0" Duration="0:0:0.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Status.SoftTile" TargetType="{x:Type local:StatusIndicator}">
        <Setter Property="local:InfoElement.ContentHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StatusIndicator}">
                    <Border x:Name="OuterBorder" 
                        Height="{Binding Path=(local:InfoElement.ContentHeight), RelativeSource={RelativeSource TemplatedParent}}"
                        Padding="8,0" CornerRadius="4" BorderThickness="1.5"
                        BorderBrush="{Binding InactiveBrush, RelativeSource={RelativeSource TemplatedParent}}"
                        Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{Binding InactiveBrush, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,8,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Path=(local:TitleElement.Title), RelativeSource={RelativeSource TemplatedParent}}" 
                                       FontSize="11" FontWeight="Bold" Foreground="#888"/>
                                <ContentPresenter />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="#1000C853"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Status.Capsule" TargetType="{x:Type local:StatusIndicator}">
        <Setter Property="local:InfoElement.ContentHeight" Value="28" />
        <Setter Property="local:IconElement.IconSize" Value="14" />
        <Setter Property="Background" Value="#F5F5F5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StatusIndicator}">
                    <Grid x:Name="RootGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="Col0" Width="Auto" />
                            <ColumnDefinition x:Name="Col1" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="Row0" Height="Auto" />
                            <RowDefinition x:Name="Row1" Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TitlePart"
                               Text="{Binding Path=(local:TitleElement.Title), RelativeSource={RelativeSource TemplatedParent}}"
                               Foreground="{Binding Path=(local:TitleElement.Foreground), RelativeSource={RelativeSource TemplatedParent}}"
                               FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>

                        <Border x:Name="IndicatorPart"
                            Height="{Binding Path=(local:InfoElement.ContentHeight), RelativeSource={RelativeSource TemplatedParent}}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14" Padding="10,2" BorderThickness="1" BorderBrush="#DDD">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Margin="0,0,6,0">
                                    <Ellipse x:Name="DotGlow" Width="8" Height="8" Fill="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{Binding InactiveBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Grid>

                                <TextBlock x:Name="IconPart"
                                       Text="{Binding Path=(local:IconElement.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="{Binding Path=(local:IconElement.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="Segoe Fluent Icons" Foreground="#666" Margin="0,0,4,0"/>

                                <ContentPresenter VerticalAlignment="Center" TextBlock.FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="DotGlow" Property="Opacity" Value="1"/>
                            <Setter TargetName="IndicatorPart" Property="BorderBrush" Value="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="IconPart" Property="Foreground" Value="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsActive" Value="True"/>
                                <Condition Property="IsPulsing" Value="True"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="Pulse">
                                    <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="DotGlow" Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulse"/>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="local:TitleElement.TitlePlacement" Value="Bottom">
                            <Setter TargetName="IndicatorPart" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="TitlePart" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="IndicatorPart" Property="HorizontalAlignment" Value="Center"/>
                        </Trigger>
                        <Trigger Property="local:TitleElement.TitlePlacement" Value="Top">
                            <Setter TargetName="TitlePart" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="IndicatorPart" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="IndicatorPart" Property="HorizontalAlignment" Value="Center"/>
                        </Trigger>
                        <Trigger Property="local:TitleElement.TitlePlacement" Value="Left">
                            <Setter TargetName="TitlePart" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="IndicatorPart" Property="Grid.Column" Value="1"/>
                        </Trigger>
                        <Trigger Property="local:TitleElement.TitlePlacement" Value="Right">
                            <Setter TargetName="IndicatorPart" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="TitlePart" Property="Grid.Column" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>