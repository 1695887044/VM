<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:W.UI.Controls">

    <Style TargetType="{x:Type local:AlarmBar}">
        <Setter Property="Background" Value="#383838" />
        <Setter Property="Height" Value="40" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AlarmBar}">
                    <Border
                        x:Name="MainBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="#383838"
                        BorderThickness="0,1"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Border
                                VerticalAlignment="Top"
                                BorderBrush="#2FFFFFFF"
                                BorderThickness="0,1,0,0"
                                Opacity="0.1" />

                            <Grid x:Name="ContentGrid">
                                <Border x:Name="NormalGrid" Visibility="Collapsed">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="1">
                                            <GradientStop Offset="0" Color="#0D00FF88" />
                                            <GradientStop Offset="1" Color="Transparent" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Ellipse
                                                x:Name="lightGlow"
                                                Width="12"
                                                Height="12"
                                                Fill="#00FF88"
                                                Opacity="0.4">
                                                <Ellipse.Effect>
                                                    <BlurEffect Radius="6" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <Ellipse
                                                Width="6"
                                                Height="6"
                                                Fill="#00FF88" />
                                        </Grid>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#00FF88"
                                            Text="SYSTEM OPERATIONAL" />
                                    </StackPanel>
                                </Border>

                                <Canvas x:Name="PART_Canvas" Background="Transparent">
                                    <ItemsControl x:Name="PART_ItemsHost" ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Height="38" Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel
                                                    Margin="0,0,80,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Path
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,10,0"
                                                        Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"
                                                        Fill="{Binding LevelColor}"
                                                        Stretch="Uniform" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding LevelColor}"
                                                        Text="{Binding Message}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.RenderTransform>
                                            <TranslateTransform x:Name="PART_Translate" />
                                        </ItemsControl.RenderTransform>
                                    </ItemsControl>
                                </Canvas>
                            </Grid>

                            <Border
                                VerticalAlignment="Bottom"
                                BorderBrush="#1FFFFFFF"
                                BorderThickness="0,0,0,1"
                                Opacity="0.05" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasAlarms" Value="False">
                            <Setter TargetName="NormalGrid" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Canvas" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="#252525" />
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="#444" />
                        </Trigger>

                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        AutoReverse="True"
                                        Storyboard.TargetName="lightGlow"
                                        Storyboard.TargetProperty="Opacity"
                                        From="0.1"
                                        To="0.6"
                                        Duration="0:0:1.5" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>