<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:W.UI.Controls">
    <SolidColorBrush x:Key="SidebarBg" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ContentBg" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6" />
    <SolidColorBrush x:Key="TextMain" Color="#1E293B" />

    <Style TargetType="{x:Type local:EasyAutoPropertyGrid}">
        <Setter Property="Background" Value="{StaticResource ContentBg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:EasyAutoPropertyGrid}">
                    <Border
                        Background="{TemplateBinding Background}"
                        ClipToBounds="True"
                        CornerRadius="8">
                        <ScrollViewer>
                            <StackPanel x:Name="PART_Panel" Background="Transparent" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>