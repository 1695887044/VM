<UserControl
    x:Class="VM.Start.Dialogs.Views.MessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvts="clr-namespace:VM.Start.Dialogs.Converts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:VM.Start.Behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="460"
    Height="240"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.Resources>
        <cvts:MsgTypeConvert x:Key="MsgCvt" />

        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB" />
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="AllowsTransparency" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Border
        Margin="10"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="20"
                Opacity="0.1"
                ShadowDepth="4"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <i:Interaction.Behaviors>
                    <local:WindowDragBehavior />
                </i:Interaction.Behaviors>

                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                        <Path
                            Width="24"
                            Height="24"
                            Data="{StaticResource info}"
                            Fill="#10B981"
                            Stretch="Uniform"
                            Visibility="{Binding MsgType, Converter={StaticResource MsgCvt}, ConverterParameter=1}" />
                        <Path
                            Width="24"
                            Height="24"
                            Data="{StaticResource warn}"
                            Fill="#F59E0B"
                            Stretch="Uniform"
                            Visibility="{Binding MsgType, Converter={StaticResource MsgCvt}, ConverterParameter=2}" />
                        <Path
                            Width="24"
                            Height="24"
                            Data="{StaticResource alarm}"
                            Fill="#EF4444"
                            Stretch="Uniform"
                            Visibility="{Binding MsgType, Converter={StaticResource MsgCvt}, ConverterParameter=3}" />
                        <Path
                            Width="24"
                            Height="24"
                            Data="{StaticResource error}"
                            Fill="#DC2626"
                            Stretch="Uniform"
                            Visibility="{Binding MsgType, Converter={StaticResource MsgCvt}, ConverterParameter=4}" />
                    </Grid>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="DemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{Binding Title}" />
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                Margin="20,20,20,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <TextBox
                    FontSize="14"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    IsReadOnly="{Binding IsReadOnly}"
                    Text="{Binding Data}"
                    TextWrapping="Wrap" />
            </ScrollViewer>

            <Border
                Grid.Row="2"
                Background="#F9FAFB"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8">
                <StackPanel
                    Margin="0,0,20,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="80"
                        Height="32"
                        Margin="0,0,12,0"
                        Command="{Binding ButtomByTagCommand}"
                        CommandParameter="cancel"
                        Content="取消"
                        Style="{DynamicResource ButtonDefault}" />
                    <Button
                        Width="80"
                        Height="32"
                        Command="{Binding ButtomByTagCommand}"
                        CommandParameter="ok"
                        Content="确定"
                        Style="{DynamicResource ButtonPrimary}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>