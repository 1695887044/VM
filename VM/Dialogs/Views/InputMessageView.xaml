<UserControl
    x:Class="VM.Start.Dialogs.Views.InputMessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VM.Start.Dialogs.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinHeight="140"
    MinWidth="300"
    d:DesignHeight="140"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <Border Grid.Column="0" CornerRadius="4">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="Gray" />
                <GradientStop Offset="1" Color="#CFCFCF" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="Bold"
                Text="{Binding Title}" />
            <TextBox Grid.Row="1" Text="{Binding ContentText}" />
            <StackPanel
                Grid.Row="2"
                Margin="0,2,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Margin="10,2"
                    Command="{Binding ConfirmCommand}"
                    Content="确认" />
                <Button
                    Margin="10,2"
                    Command="{Binding CancelCommand}"
                    Content="取消" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
