<UserControl
    x:Class="VM.Start.Dialogs.Views.GlobalVariableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:W.UI.Core;assembly=W.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="800"
    Height="600"
    Background="#F1F5F9"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Margin="0,0,0,20"
            Padding="16"
            Background="#FFFFFF"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="数据类型" />
                    <ComboBox
                        Width="130"
                        Height="34"
                        ItemsSource="{Binding AvailableTypes}"
                        SelectedItem="{Binding SelectedNewType, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="显示名称 (中)" />
                    <TextBox
                        Width="130"
                        Height="34"
                        Tag="如: 机械手偏移"
                        Text="{Binding NewUiName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="初始值" />
                    <TextBox
                        Width="130"
                        Height="34"
                        Text="{Binding NewInitialValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button
                    Grid.Column="5"
                    Height="34"
                    Padding="18,0"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource PrimaryActionBrush}"
                    BorderThickness="0"
                    Command="{Binding AddVariableCommand}"
                    Cursor="Hand"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,8,0"
                                        Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                        Fill="White"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Text="新增全局变量" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0369A1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#075985" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding GlobalDataService.GlobalDataPort}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander
                            Margin="1"
                            Header="{Binding DisplayName}"
                            IsExpanded="True"
                            Style="{StaticResource M.S.Expander1}">
                            <DataGrid
                                Grid.Row="1"
                                ItemsSource="{Binding Ports}"
                                Style="{StaticResource ModernDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding Name}"
                                        EditingElementStyle="{StaticResource ModernDgEditingTextBoxStyle}"
                                        Header="名称" />
                                    <DataGridTextColumn
                                        Width="150"
                                        Binding="{Binding SourcePath}"
                                        Header="路径"
                                        IsReadOnly="True" />
                                    <DataGridTextColumn
                                        Width="120"
                                        Binding="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                        EditingElementStyle="{StaticResource ModernDgEditingTextBoxStyle}"
                                        Header="数值" />
                                    <DataGridTextColumn
                                        Binding="{Binding Note}"
                                        EditingElementStyle="{StaticResource ModernDgEditingTextBoxStyle}"
                                        Header="备注" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>