<UserControl
    x:Class="VM.Start.Views.VarLinkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:VM.Start.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ext="clr-namespace:VM.Start.Behaviors"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#6459DF"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="ToolWindow" />
        </Style>
    </prism:Dialog.WindowStyle>
    <Grid TextElement.Foreground="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="35"
            Text="变量链接" />
        <hc:TabControl
            Grid.Row="1"
            Margin="1"
            AlternationCount="200"
            IsAnimationEnabled="True"
            IsScrollable="True"
            ItemsSource="{Binding VarService.DisplayVarList}"
            ShowOverflowButton="True">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <hc:TabControl.ContentTemplate>
                <DataTemplate>
                    <DataGrid
                        Style="{StaticResource   DataGrid.Small}"
                        AutoGenerateColumns="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ColumnWidth="*"
                        ItemsSource="{Binding VarModels}">
                        <DataGrid.Columns>
                            <DataGridTextColumn  Width="50" Binding="{Binding Index}" Header="索引" />
                            <DataGridTextColumn Width="140" Binding="{Binding Name}" Header="变量名称" />
                            <DataGridTextColumn Width="90" Binding="{Binding DataType}" Header="数据类型" />
                            <DataGridTextColumn Width="160" Binding="{Binding Value}" Header="当前数值" />
                            <DataGridTextColumn Width="*" Binding="{Binding Note}" Header="注释" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle.Small}">
                                <Setter Property="ext:DoubleClickBehavior.Command" Value="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.ConfirmCommand}"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DataTemplate>
            </hc:TabControl.ContentTemplate>
        </hc:TabControl>
    </Grid>
</UserControl>
