<UserControl
    x:Class="VM.Start.Views.ToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VM.Start.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#1A1A1A"
    mc:Ignorable="d">
    <Grid Background="#252525">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <ToolBar Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Grid}}, Path=Width}">
            <StackPanel Orientation="Horizontal">
                <Button
                    Command="{Binding ProjectCommand}"
                    CommandParameter="Create_A"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="创建流程">
                    <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/btnAddProject.png" />
                </Button>
                <Button
                    Command="{Binding ProjectCommand}"
                    CommandParameter="Delete_A"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="删除流程">
                    <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/btnDeleteProject.png" />
                </Button>
                <Button
                    Command="{Binding ProjectCommand}"
                    CommandParameter="Create_M"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="创建方法">
                    <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/function.png" />
                </Button>
                <Button
                    Command="{Binding ProjectCommand}"
                    CommandParameter="Set_M"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="设置流程">
                    <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/tsbSettingProject.png" />
                </Button>
            </StackPanel>
        </ToolBar>
        <TreeView
            Grid.Row="1"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding CurrentProject.ProcessList.Children}"
            PreviewMouseRightButtonDown="TreeView_PreviewMouseRightButtonDown">
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="SelectedItemChanged">
                    <b:InvokeCommandAction Command="{Binding Path=TreeViewChangeCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=SelectedItem}" />
                </b:EventTrigger>
            </b:Interaction.Triggers>
            <TreeView.ContextMenu>
                <ContextMenu FontFamily="{StaticResource iconfont}">
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="A"
                        Header="重命名"
                        Icon="&#xe6e3;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="B"
                        Header="流程加密"
                        Icon="&#xe7a8;">
                        <MenuItem
                            Command="{Binding TreeViewContextMenuCommand}"
                            CommandParameter="C"
                            Header="加密流程"
                            Icon="&#xe670;" />
                        <MenuItem
                            Command="{Binding TreeViewContextMenuCommand}"
                            CommandParameter="D"
                            Header="解密流程"
                            Icon="&#xe667;" />
                        <MenuItem
                            Command="{Binding TreeViewContextMenuCommand}"
                            CommandParameter="E"
                            Header="取消所有加密"
                            Icon="&#xe667;" />
                    </MenuItem>
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="F"
                        Header="创建文件夹"
                        Icon="&#xe646;" />
                    <Separator />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="G"
                        Header="编辑注释"
                        Icon="&#xe61e;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="A"
                        Header="剪切"
                        Icon="&#xe61b;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="A"
                        Header="复制"
                        Icon="&#xe623;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="A"
                        Header="粘贴"
                        Icon="&#xe624;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="A"
                        Header="删除流程"
                        Icon="&#xe8b6;" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <ScrollViewer
                        CanContentScroll="True"
                        HorizontalScrollBarVisibility="Hidden"
                        TextElement.Foreground="White"
                        VerticalScrollBarVisibility="Hidden">
                        <StackPanel
                            Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Grid}}, Path=Width}"
                            Cursor="Hand"
                            Orientation="Horizontal">
                            <TextBlock
                                Width="15"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource iconfont}"
                                Text="&#xe670;"
                                Visibility="Hidden" />
                            <TextBlock
                                Margin="2"
                                HorizontalAlignment="Left"
                                FontFamily="{DynamicResource FontAwesome}"
                                FontSize="22"
                                Text="{Binding IconText}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Foreground="Green"
                                    Text="{Binding Remark}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <GridSplitter
            Grid.Row="2"
            Height="2"
            HorizontalAlignment="Stretch"
            Background="Gray" />
        <ItemsControl Grid.Row="3" BorderThickness="0" />
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="只显示流程管理">
                <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/OnlyDisplayProcessManage.png" />
            </Button>
            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="只显示工具箱">
                <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/OnlyDisplayTool.png" />
            </Button>
            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="上下分布显示">
                <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/ExpandUpAndDown.png" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
