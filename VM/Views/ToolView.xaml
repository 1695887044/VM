<UserControl
    x:Class="VM.Start.Views.ToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:local="clr-namespace:VM.Start.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="FunctionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="#4A5568" />
            <Setter Property="BorderBrush" Value="#718096" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  悬停效果  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#6B7280" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A0AEC0" />
                            </Trigger>
                            <!--  点击效果  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2D3748" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4A5568" />
                            </Trigger>
                            <!--  禁用效果  -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  图标样式  -->
        <Style x:Key="FunctionIconStyle" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Fill" Value="White" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  文字样式  -->
        <Style x:Key="FunctionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#252525">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <ToolBar Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Grid}}, Path=Width}" Background="#252525">
            <StackPanel Orientation="Horizontal">
                <Button
                    Command="{Binding ProjectCommand}"
                    CommandParameter="Create_A"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="创建流程">
                    <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/btnAddProject.png" />
                </Button>
                <Button
                    Command="{Binding ProjectCommand}"
                    CommandParameter="Delete_A"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="删除流程">
                    <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/btnDeleteProject.png" />
                </Button>
                <Button
                    Command="{Binding ProjectCommand}"
                    CommandParameter="Create_M"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="创建方法">
                    <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/function.png" />
                </Button>
                <Button
                    Command="{Binding ProjectCommand}"
                    CommandParameter="Set_M"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="设置流程">
                    <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/tsbSettingProject.png" />
                </Button>
            </StackPanel>
        </ToolBar>
        <TreeView
            Grid.Row="1"
            AllowDrop="True"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding SolutionManager.CurrentSolution.Children}"
            PreviewMouseRightButtonDown="TreeView_PreviewMouseRightButtonDown">
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="SelectedItemChanged">
                    <b:InvokeCommandAction Command="{Binding Path=TreeViewChangeCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Path=SelectedItem}" />
                </b:EventTrigger>
            </b:Interaction.Triggers>
            <TreeView.ContextMenu>
                <ContextMenu FontFamily="{StaticResource iconfont}">
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="A"
                        Header="重命名"
                        Icon="&#xe6e3;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="B"
                        Header="流程加密"
                        Icon="&#xe7a8;">
                        <MenuItem
                            Command="{Binding TreeViewContextMenuCommand}"
                            CommandParameter="C"
                            Header="加密流程"
                            Icon="&#xe670;" />
                        <MenuItem
                            Command="{Binding TreeViewContextMenuCommand}"
                            CommandParameter="D"
                            Header="解密流程"
                            Icon="&#xe667;" />
                        <MenuItem
                            Command="{Binding TreeViewContextMenuCommand}"
                            CommandParameter="E"
                            Header="取消所有加密"
                            Icon="&#xe667;" />
                    </MenuItem>
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="F"
                        Header="创建文件夹"
                        Icon="&#xe646;" />
                    <Separator />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="G"
                        Header="编辑注释"
                        Icon="&#xe61e;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="A"
                        Header="剪切"
                        Icon="&#xe61b;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="A"
                        Header="复制"
                        Icon="&#xe623;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="A"
                        Header="粘贴"
                        Icon="&#xe624;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="A"
                        Header="删除流程"
                        Icon="&#xe8b6;" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <ScrollViewer
                        CanContentScroll="True"
                        HorizontalScrollBarVisibility="auto"
                        TextElement.Foreground="White"
                        VerticalScrollBarVisibility="Hidden">
                        <StackPanel
                            Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Grid}}, Path=Width}"
                            Cursor="Hand"
                            Orientation="Horizontal">
                            <StackPanel
                                Height="30"
                                Margin="1"
                                Orientation="Horizontal"
                                TextElement.FontSize="22">
                                <Path
                                    Width="22"
                                    Height="26"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Data="{Binding IconText}"
                                    Fill="GreenYellow"
                                    Stretch="Uniform" />

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="{Binding Name}" />

                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Foreground="Green"
                                    Text="{Binding Remark}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <GridSplitter
            Grid.Row="2"
            Height="0"
            HorizontalAlignment="Stretch"
            Background="Gray" />
        <ItemsControl
            Grid.Row="3"
            BorderThickness="0"
            ItemsSource="{Binding ToolBarSource}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander
                        Background="#4A5568"
                        FocusVisualStyle="{x:Null}"
                        Header="{Binding Name}"
                        Style="{StaticResource BaseStyle}">
                        <ItemsControl ItemsSource="{Binding Children}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Margin="4"
                                        dd:DragDrop.IsDragSource="True"
                                        dd:DragDrop.UseDefaultDragAdorner="True"
                                        dd:DragDrop.UseDefaultEffectDataTemplate="True">
                                        <Border
                                            Width="50"
                                            Height="50"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            BorderBrush="White"
                                            BorderThickness="0.5"
                                            CornerRadius="8">
                                            <Button Style="{StaticResource FunctionButtonStyle}">
                                                <StackPanel>
                                                    <Path Data="{Binding IconText}" Style="{StaticResource FunctionIconStyle}" />
                                                    <TextBlock
                                                        Margin="0,1,0,0"
                                                        Style="{StaticResource FunctionTextStyle}"
                                                        Text="{Binding Name}" />
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="只显示流程管理">
                <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/OnlyDisplayProcessManage.png" />
            </Button>
            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="只显示工具箱">
                <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/OnlyDisplayTool.png" />
            </Button>
            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="上下分布显示">
                <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/ExpandUpAndDown.png" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
