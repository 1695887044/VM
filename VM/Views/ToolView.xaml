<UserControl
    x:Class="VM.Start.Views.ToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:ext_b="clr-namespace:VM.Start.Behaviors"
    xmlns:local="clr-namespace:VM.Start.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:w_cvts="clr-namespace:W.UI.Core.Converters;assembly=W.UI"
    d:DesignHeight="450"
    d:DesignWidth="400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#1F1F1F"
    mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="MyDragAdornerTemplate">
            <Border
                Padding="12,10"
                Background="#E62D2D30"
                BorderBrush="GreenYellow"
                BorderThickness="1.5"
                CornerRadius="6"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">

                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="12"
                        Opacity="0.5"
                        ShadowDepth="4"
                        Color="Black" />
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                    <Path
                        Width="26"
                        Height="26"
                        HorizontalAlignment="Center"
                        Data="{Binding IconText}"
                        Fill="GreenYellow"
                        Stretch="Uniform" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#FAFAFA"
                        Text="{Binding Name}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="FunctionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="#4A5568" />
            <Setter Property="BorderBrush" Value="#718096" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  悬停效果  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#6B7280" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A0AEC0" />
                            </Trigger>
                            <!--  点击效果  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2D3748" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4A5568" />
                            </Trigger>
                            <!--  禁用效果  -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FunctionIconStyle" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Fill" Value="White" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FunctionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#252525">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <ToolBar Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Grid}}, Path=Width}" Background="#252525">
            <StackPanel Orientation="Horizontal">
                <Button
                    Command="{Binding ProjectCommand}"
                    CommandParameter="Create_A"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="创建流程">
                    <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/btnAddProject.png" />
                </Button>
                <Button
                    Command="{Binding ProjectCommand}"
                    CommandParameter="Delete_A"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="删除流程">
                    <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/btnDeleteProject.png" />
                </Button>
                <Button
                    Command="{Binding ProjectCommand}"
                    CommandParameter="Create_M"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="创建方法">
                    <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/function.png" />
                </Button>
                <Button
                    Command="{Binding ProjectCommand}"
                    CommandParameter="Set_M"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="设置流程">
                    <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/tsbSettingProject.png" />
                </Button>
            </StackPanel>
        </ToolBar>
        <TreeView
            Grid.Row="1"
            dd:DragDrop.IsDropTarget="True"
            ext_b:TreeViewBehavior.BindableSelectedItem="{Binding SolutionManager.CurrentSelectedNode}"
            Background="#1F1F1F"
            BorderThickness="0"
            ItemsSource="{Binding SolutionManager.CurrentSolution.Children}"
            PreviewMouseRightButtonDown="TreeView_PreviewMouseRightButtonDown">
            <TreeView.ContextMenu>
                <ContextMenu FontFamily="{StaticResource iconfont}">
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="Rename"
                        Header="重命名"
                        Icon="&#xe6e3;" />
                    <MenuItem Header="流程加密" Icon="&#xe7a8;">
                        <MenuItem
                            Command="{Binding TreeViewContextMenuCommand}"
                            CommandParameter="Encrypt"
                            Header="加密流程"
                            Icon="&#xe670;" />
                        <MenuItem
                            Command="{Binding TreeViewContextMenuCommand}"
                            CommandParameter="Decrypt"
                            Header="解密流程"
                            Icon="&#xe667;" />
                        <MenuItem
                            Command="{Binding TreeViewContextMenuCommand}"
                            CommandParameter="ClearAllEncryption"
                            Header="取消所有加密"
                            Icon="&#xe667;" />
                    </MenuItem>

                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="CreateFolder"
                        Header="创建文件夹"
                        Icon="&#xe646;" />
                    <Separator />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="EditComment"
                        Header="编辑注释"
                        Icon="&#xe61e;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="Cut"
                        Header="剪切"
                        Icon="&#xe61b;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="Copy"
                        Header="复制"
                        Icon="&#xe623;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="Paste"
                        Header="粘贴"
                        Icon="&#xe624;" />
                    <MenuItem
                        Command="{Binding TreeViewContextMenuCommand}"
                        CommandParameter="Delete"
                        Header="删除流程"
                        Icon="&#xe8b6;" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        x:Name="Bd"
                                        Padding="2,4"
                                        Background="Transparent"
                                        CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton
                                                x:Name="Expander"
                                                ClickMode="Press"
                                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                        <Border Padding="3" Background="Transparent">
                                                            <Path
                                                                x:Name="Arrow"
                                                                Width="12"
                                                                Height="12"
                                                                Data="M 3,0 L 8,5 L 3,10"
                                                                Fill="#94A3B8"
                                                                RenderTransformOrigin="0.5,0.5"
                                                                Stretch="Uniform"
                                                                Stroke="#94A3B8"
                                                                StrokeThickness="1.5">
                                                                <Path.RenderTransform>
                                                                    <RotateTransform Angle="0" />
                                                                </Path.RenderTransform>
                                                            </Path>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="90" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter TargetName="Arrow" Property="Fill" Value="#E2E8F0" />
                                                                <Setter TargetName="Arrow" Property="Stroke" Value="#E2E8F0" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Arrow" Property="Fill" Value="#0284C7" />
                                                                <Setter TargetName="Arrow" Property="Stroke" Value="#0284C7" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <ContentPresenter Grid.Column="1" ContentSource="Header" />
                                        </Grid>
                                    </Border>
                                    <ItemsPresenter
                                        x:Name="ItemsHost"
                                        Grid.Row="1"
                                        Visibility="Collapsed" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                    </Trigger>

                                    <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#333333" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#007ACC" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel
                        Height="30"
                        Margin="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Converter={w_cvts:TreeViewIndentConverter IndentStep=16}}"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        Orientation="Horizontal">
                        <Path
                            x:Name="IconPath"
                            Width="15"
                            Height="15"
                            Margin="5,0,10,0"
                            VerticalAlignment="Center"
                            Data="{Binding IconText}"
                            Fill="GreenYellow"
                            Stretch="Uniform" />
                        <TextBlock
                            x:Name="NameText"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="White"
                            Text="{Binding Name}" />
                        <TextBlock
                            x:Name="RemarkText"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="Green"
                            Text="{Binding Remark}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                            <Setter TargetName="RemarkText" Property="Foreground" Value="#A6E22E" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <GridSplitter
            Grid.Row="2"
            Height="0"
            HorizontalAlignment="Stretch"
            Background="Gray" />
        <ItemsControl
            Grid.Row="3"
            BorderThickness="0"
            ItemsSource="{Binding ToolBarSource}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander
                        Background="#4A5568"
                        FocusVisualStyle="{x:Null}"
                        Header="{Binding Name}"
                        Style="{StaticResource BaseStyle}">

                        <ItemsControl
                            dd:DragDrop.DragAdornerTemplate="{StaticResource MyDragAdornerTemplate}"
                            dd:DragDrop.IsDragSource="True"
                            dd:DragDrop.UseDefaultDragAdorner="True"
                            dd:DragDrop.UseDefaultEffectDataTemplate="True"
                            ItemsSource="{Binding Children}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">

                                        <Border
                                            Width="50"
                                            Height="50"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="White"
                                            BorderThickness="0.5"
                                            CornerRadius="8"
                                            Cursor="Hand">

                                            <StackPanel VerticalAlignment="Center">
                                                <Path Data="{Binding IconText}" Style="{StaticResource FunctionIconStyle}" />
                                                <TextBlock
                                                    Margin="0,1,0,0"
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource FunctionTextStyle}"
                                                    Text="{Binding Name}" />
                                            </StackPanel>

                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="只显示流程管理">
                <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/OnlyDisplayProcessManage.png" />
            </Button>
            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="只显示工具箱">
                <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/OnlyDisplayTool.png" />
            </Button>
            <Button Style="{StaticResource ToolBarButtonStyle}" ToolTip="上下分布显示">
                <Image Source="pack://application:,,,/VM.Shard;component/Assets/Images/ToolBar/ExpandUpAndDown.png" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
