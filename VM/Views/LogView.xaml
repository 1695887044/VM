<UserControl
    x:Class="VM.Start.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:VM.Start.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    Background="#574EB9"
    Opacity="0.6"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <hc:UniformSpacingPanel
            Margin="20,14,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            ChildWrapping="Wrap"
            Spacing="20">
            <hc:Badge
                Height="30"
                Background="Green"
                BadgeMargin="0,-14,-20,0"
                Foreground="White"
                Text="10020">
                <Button
                    hc:IconElement.Geometry="{StaticResource info}"
                    Content="信息"
                    Foreground="Green" />
            </hc:Badge>
            <hc:Badge
                Height="30"
                Background="Orange"
                BadgeMargin="0,-14,-20,0"
                Foreground="White"
                Text="10020">
                <Button
                    hc:IconElement.Geometry="{StaticResource warn}"
                    Content="警告"
                    Foreground="Orange" />
            </hc:Badge>
            <hc:Badge
                Height="30"
                Background="OrangeRed"
                BadgeMargin="0,-14,-20,0"
                Foreground="White"
                Text="10020">
                <Button
                    hc:IconElement.Geometry="{StaticResource error}"
                    Content="错误"
                    Foreground="OrangeRed" />
            </hc:Badge>
            <hc:Badge
                Height="30"
                Background="Red"
                BadgeMargin="0,-14,-20,0"
                Foreground="White"
                Text="10020">
                <Button
                    hc:IconElement.Geometry="{StaticResource alarm}"
                    Content="报警"
                    Foreground="Red" />
            </hc:Badge>

        </hc:UniformSpacingPanel>
        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            BorderThickness="0"
            CanUserAddRows="False"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            FontSize="12"
            Background="Transparent"
            Foreground="White"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            IsReadOnly="True"
            RowHeaderWidth="20"
            SelectionUnit="FullRow"
            VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn
                    Width="150"
                    Header="时间"
                    IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Foreground="{Binding LogColor}"
                                Text="{Binding CreateTime, StringFormat=\{0:yyyy/MM/dd HH:mm:ss fff\}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Width="50"
                    Header="类型"
                    IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Foreground="{Binding LogColor}"
                                Text="{Binding LogType}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Width="*"
                    Header="内容"
                    IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Foreground="{Binding LogColor}"
                                Text="{Binding Content}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
