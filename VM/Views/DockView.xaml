<UserControl
    x:Class="VM.Start.Views.DockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VM.Start.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
     Background="Transparent"
    mc:Ignorable="d">
    <Grid>
        <avalonDock:DockingManager
            AllowMixedOrientation="True"
            AutoWindowSizeWhenOpened="True"
            Background="Transparent"
            IsVirtualizingAnchorable="True"
            IsVirtualizingDocument="True">
            <avalonDock:DockingManager.Theme>
                <Vs2013DarkTheme />
            </avalonDock:DockingManager.Theme>
            <DockingManager.DocumentHeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Margin="0,0,4,0" Source="{Binding IconSource}" />
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </DockingManager.DocumentHeaderTemplate>
            <LayoutRoot>
                <LayoutPanel Orientation="Horizontal">
                    <LayoutAnchorablePane DockWidth="220">
                        <LayoutAnchorable
                            Title="[工具栏]"
                            CanAutoHide="True"
                            CanClose="False"
                            CanHide="True"
                            Content="{x:Static local:ToolView.Ins}"
                            ContentId="Tool" />
                    </LayoutAnchorablePane>
                    <LayoutAnchorablePane DockWidth="280">
                        <LayoutAnchorable
                            Title="[流程栏]"
                            CanAutoHide="True"
                            CanClose="False"
                              Content="{x:Static local:ProcessView.Ins}"
                            CanHide="True"
                            ContentId="Process" />
                    </LayoutAnchorablePane>
                    <LayoutPanel DockWidth="1.06422018348624*" Orientation="Vertical">
                        <LayoutDocumentPaneGroup Orientation="Horizontal">
                            <LayoutDocumentPane DockWidth="0.65*">
                                <LayoutDocument
                                    Title="[图像栏]"
                                    CanClose="False"                              
                                       Content="{x:Static local:VisionView.Ins}"
                                    IsSelected="True" />
                            </LayoutDocumentPane>
                        </LayoutDocumentPaneGroup>
                        <LayoutAnchorablePaneGroup
                                DockHeight="277.6"
                                FloatingHeight="300"
                                FloatingLeft="1034.4"
                                FloatingTop="544.8"
                                FloatingWidth="136"
                                Orientation="Vertical">
                            <LayoutAnchorablePane
                                    DockHeight="277.6"
                                    DockWidth="1.65746549560853*"
                                    FloatingHeight="300"
                                    FloatingLeft="1034.4"
                                    FloatingTop="544.8"
                                    FloatingWidth="136">
                                <LayoutAnchorable
                                        Title="[日志]"
                                        AutoHideHeight="300"
                                        AutoHideMinHeight="200"
                                        Content="{x:Static local:LogView.Ins}"
                                        ContentId="Log"
                                        FloatingHeight="300" />
                                <LayoutAnchorable
                                        Title="[数据]"
                                        AutoHideHeight="300"
                                        AutoHideMinHeight="200"
                                        ContentId="Data"
                                        FloatingHeight="300" />
                                <LayoutAnchorable
                                        Title="[输出]"
                                        AutoHideHeight="300"
                                        AutoHideMinHeight="200"
                                        ContentId="ModuleOut"
                                        FloatingHeight="300" />
                                <LayoutAnchorable
                                        Title="[设备状态]"
                                        AutoHideHeight="300"
                                        AutoHideMinHeight="200"
                                        ContentId="DeviceState"
                                        FloatingHeight="300" />
                            </LayoutAnchorablePane>
                        </LayoutAnchorablePaneGroup>

                    </LayoutPanel>
                </LayoutPanel>
            </LayoutRoot>
        </avalonDock:DockingManager>
    </Grid>
</UserControl>
