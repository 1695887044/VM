<UserControl
    x:Class="VM.Start.Views.DockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VM.Start.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <avalonDock:DockingManager
            x:Name="dockManager"
            AllowMixedOrientation="True"
            AutoWindowSizeWhenOpened="True"
            Background="Transparent"
            IsVirtualizingAnchorable="True"
            IsVirtualizingDocument="True">
            <avalonDock:DockingManager.Theme>
                <Vs2013DarkTheme />
            </avalonDock:DockingManager.Theme>
            <DockingManager.DocumentHeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Margin="0,0,4,0" Source="{Binding IconSource}" />
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </DockingManager.DocumentHeaderTemplate>
            <LayoutRoot>
                <LayoutPanel Orientation="Horizontal">
                    <LayoutAnchorablePane DockWidth="0.15*">
                        <LayoutAnchorable
                            Title="工具栏"
                            CanAutoHide="True"
                            CanClose="False"
                            CanHide="True"
                            ContentId="Tool" />
                    </LayoutAnchorablePane>
                    <LayoutAnchorablePane DockWidth="0.2*">
                        <LayoutAnchorable
                            Title="流程栏"
                            CanAutoHide="True"
                            CanClose="False"
                            CanHide="True"
                            ContentId="Tool" />
                    </LayoutAnchorablePane>
                    <LayoutAnchorablePane DockWidth="0.65*">
                        <LayoutAnchorable
                            Title="图像栏"
                            CanAutoHide="True"
                            CanClose="False"
                            CanHide="True"
                            ContentId="Tool" />
                    </LayoutAnchorablePane>
                </LayoutPanel>
                <LayoutRoot.BottomSide>
                    <LayoutAnchorSide>
                        <LayoutAnchorGroup>
                            <LayoutAnchorable
                                Title="日志信息"
                                AutoHideHeight="300"
                                AutoHideMinHeight="200"
                                FloatingHeight="300" />
                            <LayoutAnchorable
                                Title="数据栏"
                                AutoHideHeight="300"
                                AutoHideMinHeight="200"
                                FloatingHeight="300" />
                            <LayoutAnchorable
                                Title="模块输出"
                                AutoHideHeight="300"
                                AutoHideMinHeight="200"
                                FloatingHeight="300" />
                            <LayoutAnchorable
                                Title="设备状态"
                                AutoHideHeight="300"
                                AutoHideMinHeight="200"
                                FloatingHeight="300" />
                        </LayoutAnchorGroup>
                    </LayoutAnchorSide>
                </LayoutRoot.BottomSide>
            </LayoutRoot>
        </avalonDock:DockingManager>
    </Grid>
</UserControl>
