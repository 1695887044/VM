<UserControl
    x:Class="Plugin.PerProcessing.Views.PerPrecessView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:com="clr-namespace:Plugin.PerProcessing.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:ext="clr-namespace:Plugin.PerProcessing.Extensions"
    xmlns:halconCt="clr-namespace:VM.Halcon.Controls;assembly=VM.Halcon"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:linkCt="clr-namespace:VM.IPlugin.Controls;assembly=VM.IPlugin"
    xmlns:local="clr-namespace:Plugin.PerProcessing.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Plugin.PerProcessing.Model"
    xmlns:w="clr-namespace:W.UI.Controls;assembly=W.UI"
    Width="980"
    Height="680"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ItemBorderStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="BorderBrush" Value="#FFD0D0D0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="TextElement.Foreground" Value="Gray" />
                </DataTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsEnabled" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#FF8CB5FF" />
                    <Setter Property="BorderThickness" Value="1" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsEnabled" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#FF909090" />
                    <Setter Property="BorderThickness" Value="1" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TabControl hc:TabControl.ShowCloseButton="False">
            <TabItem
                hc:IconElement.Geometry="{StaticResource AddGeometry}"
                hc:IconElement.Height="16"
                hc:IconElement.Width="16"
                Header="基本参数">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="80" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <GroupBox Header="图像链接">

                        <linkCt:LabelLinkPath
                            Header="图像链接"
                            OperatorCommand="{Binding LinkPathCommand}"
                            Value="{Binding CurImage}" />
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem
                hc:IconElement.Geometry="{StaticResource AddGeometry}"
                hc:IconElement.Height="16"
                hc:IconElement.Width="16"
                Header="参数设置">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="280" />
                    </Grid.RowDefinitions>
                    <StackPanel Height="30" Orientation="Horizontal">
                        <Menu
                            Width="45"
                            Margin="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip="添加">
                            <MenuItem
                                HorizontalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Header="添加">
                                <MenuItem
                                    HorizontalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Header="图像调整">
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="彩色转灰"
                                        Header="彩色转灰" />
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="图像镜像"
                                        Header="图像镜像" />
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="图像旋转"
                                        Header="图像旋转" />
                                    <MenuItem Header="深度转彩色" />
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="修改图像尺寸"
                                        Header="修改图像尺寸" />
                                </MenuItem>
                                <MenuItem
                                    HorizontalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Header="滤波">
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="均值滤波"
                                        Header="均值滤波" />
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="中值滤波"
                                        Header="中值滤波" />
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="高斯滤波"
                                        Header="高斯滤波" />
                                </MenuItem>
                                <MenuItem
                                    HorizontalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Header="形态学运算">
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="灰度膨胀"
                                        Header="灰度膨胀" />
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="灰度腐蚀"
                                        Header="灰度腐蚀" />
                                </MenuItem>
                                <MenuItem
                                    HorizontalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Header="图像增强">
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="锐化"
                                        Header="锐化" />
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="对比度"
                                        Header="对比度" />
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="亮度调节"
                                        Header="亮度调节" />
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="灰度开运算"
                                        Header="灰度开运算" />
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="灰度闭运算"
                                        Header="灰度闭运算" />
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="反色"
                                        Header="反色" />
                                </MenuItem>
                                <MenuItem
                                    HorizontalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Header="二值化">
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="二值化"
                                        Header="二值化" />
                                    <MenuItem
                                        Command="{Binding DataOperateCommand}"
                                        CommandParameter="均值二值化"
                                        Header="均值二值化" />
                                </MenuItem>
                            </MenuItem>
                        </Menu>
                        <Button
                            Width="45"
                            Margin="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding DataOperateCommand}"
                            CommandParameter="显示原图"
                            Content="原图"
                            Style="{StaticResource M.S.IconButton}"
                            ToolTip="显示原图" />
                    </StackPanel>
                    <ListBox
                        x:Name="personListBox"
                        Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        dd:DragDrop.IsDragSource="True"
                        dd:DragDrop.IsDropTarget="True"
                        dd:DragDrop.UseDefaultDragAdorner="True"
                        dd:DragDrop.UseDefaultEffectDataTemplate="True"
                        ItemsSource="{Binding M_ToolData}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding CurrentItem}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ItemBorderStyle}" Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Border.ToolTip>
                                        <TextBlock
                                            MaxWidth="300"
                                            Padding="6,3"
                                            Background="Transparent"
                                            Foreground="Green"
                                            Text="{Binding Note}"
                                            TextWrapping="Wrap" />
                                    </Border.ToolTip>
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Mode=Self}}">
                                            <MenuItem
                                                Header="启用/屏蔽"
                                                IsCheckable="True"
                                                IsChecked="{Binding PlacementTarget.DataContext.IsEnabled, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}" />
                                            <MenuItem
                                                Command="{Binding ToolDataOperateCommand}"
                                                CommandParameter="B"
                                                Header="修改模块名" />
                                            <MenuItem
                                                Command="{Binding ToolDataOperateCommand}"
                                                CommandParameter="C"
                                                Header="修改注释" />
                                            <MenuItem
                                                Command="{Binding ToolDataOperateCommand}"
                                                CommandParameter="D"
                                                Header="删除" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <ContentControl>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Text="{Binding Name}" />
                                            <Rectangle
                                                Grid.Column="1"
                                                Height="1"
                                                Margin="4,0"
                                                VerticalAlignment="Center"
                                                Fill="LightGray" />
                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Text="{Binding ToolParamer.DisplayValue}" />
                                        </Grid>
                                    </ContentControl>

                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <w:EasyAutoPropertyGrid Grid.Row="2" BindingObject="{Binding CurrentItem.ToolParamer}" />
                </Grid>
            </TabItem>


        </TabControl>
        <halconCt:ImageDisplay Grid.Column="1" HImage="{Binding CurrentHImage}" />
    </Grid>
</UserControl>
