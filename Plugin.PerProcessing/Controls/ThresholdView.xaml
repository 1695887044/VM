<UserControl
    x:Class="Plugin.PerProcessing.Controls.ThresholdView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Plugin.PerProcessing.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="AliceBlue"
    d:DesignHeight="300"
    d:DesignWidth="250"
    mc:Ignorable="d">
    <StackPanel Orientation="Vertical">
        <StackPanel Margin="20,10,10,10" Orientation="Horizontal">
            <TextBlock
                Width="60"
                VerticalAlignment="Center"
                Text="低阈值:" />
            <Slider
                Width="160"
                Margin="5,0"
                hc:TitleElement.Title="32"
                Maximum="255"
                Minimum="0"
                Value="{Binding ThresholdLow}" />
        </StackPanel>
        <StackPanel Margin="20,10,10,10" Orientation="Horizontal">
            <TextBlock
                Width="60"
                VerticalAlignment="Center"
                Text="高阈值:" />
            <Slider
                Width="160"
                Margin="5,0"
                Maximum="255"
                Minimum="0"
                Value="{Binding ThresholdHight}" />
        </StackPanel>
        <StackPanel Margin="20,10,10,10" Orientation="Horizontal">
            <CheckBox
                MinWidth="200"
                HorizontalAlignment="Center"
                Content="黑白反转"
                IsChecked="{Binding ThresholdReverse}" />
        </StackPanel>
    </StackPanel>
</UserControl>
