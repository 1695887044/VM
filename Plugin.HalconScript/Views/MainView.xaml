<UserControl
    x:Class="Plugin.HalconScript.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:linkCt="clr-namespace:VM.IPlugin.Controls;assembly=VM.IPlugin"
    xmlns:local="clr-namespace:Plugin.HalconScript.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:w="clr-namespace:W.UI.Controls;assembly=W.UI"
    Width="800"
    Height="500"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  通用 TextBlock 样式：统一字体、对齐、边距  -->
        <Style x:Key="HalconItemTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#343A40" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4" />
        </Style>

        <!--  Name 列 TextBlock 样式：右对齐，突出标签属性  -->
        <Style
            x:Key="HalconNameTextStyle"
            BasedOn="{StaticResource HalconItemTextStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#495057" />
        </Style>

        <!--  Data 列 TextBlock 样式：左对齐，支持文本换行  -->
        <Style
            x:Key="HalconDataTextStyle"
            BasedOn="{StaticResource HalconItemTextStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="30" />
            <!--  保证行高一致  -->
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TabControl>
            <TabItem Header="基本参数">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="2">
                        <Button
                            Width="100"
                            Command="{Binding OperatorCommand}"
                            CommandParameter="Import"
                            Content="导入" />
                        <Button
                            Width="100"
                            Command="{Binding OperatorCommand}"
                            CommandParameter="Export"
                            Content="导出" />
                    </UniformGrid>
                    <GroupBox
                        Grid.Row="1"
                        Header="运行参数"
                        Style="{StaticResource GroupBoxOriginal}">
                        <TextBlock hc:TitleElement.Title="文件名称" Text="{Binding HaclonName}" />
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="输入链接">
                <ItemsControl ItemsSource="{Binding HalconIn}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <linkCt:LabelLinkPath
                                Header="{Binding Name}"
                                OperatorCommand="{Binding DataContext.LabelLinkCommand,RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}"
                                LinkParam="{Binding}"
                                Value="{Binding Data}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </TabItem>
            <TabItem Header="输出变量">
                <ItemsControl ItemsSource="{Binding HalconOut}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </TabItem>
            <TabItem Header="其它选项" />
        </TabControl>
        <TextBox
            Grid.Column="1"
            HorizontalContentAlignment="Stretch"
            Background="White"
            IsReadOnly="True"
            Text="{Binding HalconCode}" />
    </Grid>
</UserControl>
