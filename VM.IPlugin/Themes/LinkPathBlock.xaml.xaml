<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="clr-namespace:VM.IPlugin.Controls">
    <Style TargetType="ct:LinkPathBlock">
        <Setter Property="Width" Value="240" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ct:LinkPathBlock">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="10" MaxWidth="100" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,2,2,2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="{TemplateBinding Header}" />
                        <TextBox
                            Grid.Column="1"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="White"
                            BorderThickness="0,0,0,1"
                            Text="{TemplateBinding LinkPathName}" />
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Margin="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                MaxWidth="40"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{TemplateBinding LinkPathCommand}"
                                CommandParameter="Link"
                                Content="🔗"
                                FontWeight="Bold"
                                ToolTip="链接变量">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#234A64"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                Margin="2"
                                 MaxWidth="40"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{TemplateBinding LinkPathCommand}"
                                CommandParameter="Close"
                                Content="✖"
                                FontWeight="Bold"
                                ToolTip="清空" >
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#234A64"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>