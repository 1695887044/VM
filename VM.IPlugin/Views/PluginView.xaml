<Window
    x:Class="VM.IPlugin.Views.PluginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VM.IPlugin.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="FontSize" Value="18" />
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Geometry x:Key="info">
            M512 224m-64 0a64 64 0 1 0 128 0 64 64 0 1 0-128 0Z M544 392h-64c-4.4 0-8 3.6-8 8v464c0 4.4 3.6 8 8 8h64c4.4 0 8-3.6 8-8V400c0-4.4-3.6-8-8-8z
        </Geometry>
    </Window.Resources>
    <Grid x:Name="PART_grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Background="#1D4ED8"
            MouseLeftButtonDown="StackPanel_MouseLeftButtonDown"
            Orientation="Horizontal">
            <Path
                x:Name="IconCtl"
                Width="24"
                Height="24"
                Margin="5,4,20,4"
                Data="{Binding IconCtl}"
                Fill="White"
                Stretch="Uniform" />
            <TextBlock
                x:Name="titleCtl"
                VerticalAlignment="Center"
                FontSize="20"
                Foreground="White"
                Text="{Binding Title}" />
        </StackPanel>
        <ContentControl
            x:Name="PART_View"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
        <DockPanel
            Grid.Row="2"
            Background=" #FFFFFF"
            TextElement.FontSize="16"
            LastChildFill="True">
            <TextBlock
                x:Name="textBlock"
                Margin="10,2"
                VerticalAlignment="Center"
                DockPanel.Dock="Left">
                <Run Text="耗时:" />
                <Run x:Name="t1" />
                <Run Text="ms" />
                <LineBreak />
                <Run Text="状态:" />
                <Run x:Name="t2" />
            </TextBlock>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Button
                    Background="#16A34A"
                    BorderThickness="0.4"
                    Click="Button_Click"
                    Content="执行"
                    Foreground="White" />
                <Button
                    Background="Transparent"
                    BorderThickness="0.4"
                    Click="Button_Click_1"
                    Content="取消" />
                <Button
                    Background="#2563EB"
                    BorderThickness="0.4"
                    Click="Button_Click_2"
                    Content="确认"
                    Foreground="White" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
