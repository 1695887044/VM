<UserControl
    x:Class="Plugin.Matching.Dock.ShapeParamView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Plugin.Matching.Dock"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="White"
    d:DesignHeight="450"
    d:DesignWidth="400"
    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
    mc:Ignorable="d">
    <StackPanel>
        <Expander Header="创建模板参数" Style="{StaticResource BaseStyle}">
            <StackPanel
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="140"
                TextElement.FontSize="12">
                <hc:ComboBox
                    Margin="2"
                    hc:TitleElement.Title="图像金字塔"
                    Text="{Binding MathchingService.TemplateParameter.NumLevels}"
                    ToolTip="形状模型的优化策略（控制模型的内存占用、匹配速度）">
                    <ComboBoxItem>auto</ComboBoxItem>
                    <ComboBoxItem>0</ComboBoxItem>
                    <ComboBoxItem>1</ComboBoxItem>
                    <ComboBoxItem>2</ComboBoxItem>
                    <ComboBoxItem>3</ComboBoxItem>
                    <ComboBoxItem>4</ComboBoxItem>
                    <ComboBoxItem>5</ComboBoxItem>
                    <ComboBoxItem>6</ComboBoxItem>
                    <ComboBoxItem>7</ComboBoxItem>
                    <ComboBoxItem>8</ComboBoxItem>
                    <ComboBoxItem>9</ComboBoxItem>
                    <ComboBoxItem>10</ComboBoxItem>
                </hc:ComboBox>
                <hc:NumericUpDown
                    Margin="2"
                    hc:InfoElement.ContentHeight="27"
                    hc:TitleElement.Title="开始角度"
                    Increment="5"
                    Maximum="360"
                    Minimum="0"
                    Style="{StaticResource NumericUpDownPlus.Small}"
                    ToolTip="目标物体的起始旋转角度（匹配时允许的角度范围起点）"
                    Value="{Binding MathchingService.TemplateParameter.AngleStart}" />
                <hc:NumericUpDown
                    Margin="2"
                    hc:InfoElement.ContentHeight="27"
                    hc:TitleElement.Title="结束角度"
                    Increment="5"
                    Maximum="360"
                    Minimum="0"
                    Style="{StaticResource NumericUpDownPlus.Small}"
                    ToolTip="目标物体的起始旋转角度（匹配时允许的角度范围终点）"
                    Value="{Binding MathchingService.TemplateParameter.AngleExtent}" />
                <hc:ComboBox
                    Margin="2"
                    hc:TitleElement.Title="步长"
                    Text="{Binding MathchingService.TemplateParameter.AngleStep}"
                    ToolTip="步长越小，角度匹配精度越高，但匹配速度越慢；步长越大则反之">
                    <ComboBoxItem>auto</ComboBoxItem>
                    <ComboBoxItem>0.01</ComboBoxItem>
                    <ComboBoxItem>0.03</ComboBoxItem>
                    <ComboBoxItem>0.05</ComboBoxItem>
                    <ComboBoxItem>0.06</ComboBoxItem>
                    <ComboBoxItem>0.08</ComboBoxItem>
                </hc:ComboBox>
                <hc:ComboBox
                    Margin="2"
                    hc:TitleElement.Title="优化策略"
                    Text="{Binding MathchingService.TemplateParameter.Optimization}"
                    ToolTip="形状模型的优化策略（控制模型的内存占用、匹配速度）">
                    <ComboBoxItem>auto</ComboBoxItem>
                    <ComboBoxItem>none</ComboBoxItem>
                    <ComboBoxItem>point_reduction_low</ComboBoxItem>
                    <ComboBoxItem>point_reduction_medium</ComboBoxItem>
                    <ComboBoxItem>point_reduction_high</ComboBoxItem>
                    <ComboBoxItem>pregeneration</ComboBoxItem>
                    <ComboBoxItem>no_pregeneration</ComboBoxItem>
                </hc:ComboBox>
                <hc:ComboBox
                    Margin="2"
                    hc:TitleElement.Title="极性规则"
                    Text="{Binding MathchingService.TemplateParameter.Metric}"
                    ToolTip="模板是 “亮背景 + 暗物体”，目标也必须是同样的明暗关系">
                    <ComboBoxItem>use_polarity</ComboBoxItem>
                    <ComboBoxItem>ignore_global_polarity</ComboBoxItem>
                    <ComboBoxItem>ignore_local_polarity</ComboBoxItem>
                    <ComboBoxItem>ignore_color_polarity</ComboBoxItem>
                </hc:ComboBox>
                <hc:ComboBox
                    Margin="2"
                    hc:TitleElement.Title="对比度阈值"
                    Text="{Binding MathchingService.TemplateParameter.Contrast}"
                    ToolTip="值过低会包含噪声边缘，值过高会丢失有效边缘，影响模板的质量">
                    <ComboBoxItem>auto</ComboBoxItem>
                    <ComboBoxItem>auto_contrast</ComboBoxItem>
                    <ComboBoxItem>auto_contrast_hyst</ComboBoxItem>
                    <ComboBoxItem>auto_min_size</ComboBoxItem>
                    <ComboBoxItem>10</ComboBoxItem>
                    <ComboBoxItem>20</ComboBoxItem>
                    <ComboBoxItem>30</ComboBoxItem>
                    <ComboBoxItem>40</ComboBoxItem>
                    <ComboBoxItem>60</ComboBoxItem>
                    <ComboBoxItem>80</ComboBoxItem>
                </hc:ComboBox>
                <hc:ComboBox
                    Margin="2"
                    hc:TitleElement.Title="最小对比度"
                    Text="{Binding MathchingService.TemplateParameter.MinContrast}"
                    ToolTip="过滤低于该值的边缘，进一步提纯模板特征">
                    <ComboBoxItem>auto</ComboBoxItem>
                    <ComboBoxItem>1</ComboBoxItem>
                    <ComboBoxItem>2</ComboBoxItem>
                    <ComboBoxItem>3</ComboBoxItem>
                    <ComboBoxItem>4</ComboBoxItem>
                    <ComboBoxItem>5</ComboBoxItem>
                    <ComboBoxItem>7</ComboBoxItem>
                    <ComboBoxItem>10</ComboBoxItem>
                    <ComboBoxItem>20</ComboBoxItem>
                    <ComboBoxItem>30</ComboBoxItem>
                    <ComboBoxItem>40</ComboBoxItem>
                </hc:ComboBox>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Margin="5,5"
                        Command="{Binding MathchOperatorCommand}"
                        CommandParameter="Load"
                        Content="加载"
                        hc:IconElement.Geometry="{StaticResource DialogBoxLauncherGeometry}"
                        Style="{StaticResource ButtonPrimary}" />
                    <Button
                        Margin="5,5"
                        Command="{Binding MathchOperatorCommand}"
                        CommandParameter="Create"
                        Content="创建"
                           hc:IconElement.Geometry="{StaticResource AddGeometry}"
                        Style="{StaticResource ButtonPrimary}" />
                    <Button
                        Margin="5,5"
                        Command="{Binding MathchOperatorCommand}"
                        CommandParameter="Save"
                        hc:IconElement.Geometry="{StaticResource SaveGeometry}"
                        Content="保存"
                        Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
            </StackPanel>
        </Expander>
        <Expander Header="模板查找参数" Style="{StaticResource BaseStyle}">
            <StackPanel>
                <hc:NumericUpDown
                    Margin="2"
                    hc:InfoElement.ContentHeight="27"
                    hc:TitleElement.Title="开始角度"
                    Increment="5"
                    Maximum="360"
                    Minimum="0"
                    Style="{StaticResource NumericUpDownPlus.Small}"
                    ToolTip="目标物体的起始旋转角度（匹配时允许的角度范围起点）"
                    Value="{Binding MathchingService.RunParameter.AngleStart}" />
                <hc:NumericUpDown
                    Margin="2"
                    hc:InfoElement.ContentHeight="27"
                    hc:TitleElement.Title="最低得分"
                    Increment="5"
                    Maximum="360"
                    Minimum="0"
                    Style="{StaticResource NumericUpDownPlus.Small}"
                    Value="{Binding MathchingService.RunParameter.AngleExtent}" />
                <hc:NumericUpDown
                    Margin="2"
                    hc:InfoElement.ContentHeight="27"
                    hc:TitleElement.Title="匹配数量"
                    Increment="5"
                    Maximum="360"
                    Minimum="0"
                    Style="{StaticResource NumericUpDownPlus.Small}"
                    Value="{Binding MathchingService.RunParameter.NumMatches}" />
                <hc:NumericUpDown
                    Margin="2"
                    hc:InfoElement.ContentHeight="27"
                    hc:TitleElement.Title="最大重叠度"
                    Increment="5"
                    Maximum="360"
                    Minimum="0"
                    Style="{StaticResource NumericUpDownPlus.Small}"
                    Value="{Binding MathchingService.RunParameter.MaxOverlap}" />
                <hc:ComboBox
                    Margin="2"
                    hc:TitleElement.Title="亚像素精度"
                    Text="{Binding MathchingService.RunParameter.SubPixel}"
                    ToolTip="形状模型的优化策略（控制模型的内存占用、匹配速度）">
                    <ComboBoxItem>none</ComboBoxItem>
                    <ComboBoxItem>none</ComboBoxItem>
                    <ComboBoxItem>interpolation</ComboBoxItem>
                    <ComboBoxItem>least_squares</ComboBoxItem>
                    <ComboBoxItem>least_squares_high</ComboBoxItem>
                    <ComboBoxItem>least_squares_very_high</ComboBoxItem>
                    <ComboBoxItem>max_deformation 1</ComboBoxItem>
                    <ComboBoxItem>max_deformation 2</ComboBoxItem>
                    <ComboBoxItem>max_deformation 3</ComboBoxItem>
                    <ComboBoxItem>max_deformation 4</ComboBoxItem>
                    <ComboBoxItem>max_deformation 5</ComboBoxItem>
                    <ComboBoxItem>max_deformation 6</ComboBoxItem>
                </hc:ComboBox>
                <hc:ComboBox
                    Margin="2"
                    hc:TitleElement.Title="图像金字塔"
                    Text="{Binding MathchingService.RunParameter.NumLevels}">
                    <ComboBoxItem>auto</ComboBoxItem>
                    <ComboBoxItem>0</ComboBoxItem>
                    <ComboBoxItem>1</ComboBoxItem>
                    <ComboBoxItem>2</ComboBoxItem>
                    <ComboBoxItem>3</ComboBoxItem>
                    <ComboBoxItem>4</ComboBoxItem>
                    <ComboBoxItem>5</ComboBoxItem>
                    <ComboBoxItem>6</ComboBoxItem>
                    <ComboBoxItem>7</ComboBoxItem>
                    <ComboBoxItem>8</ComboBoxItem>
                    <ComboBoxItem>9</ComboBoxItem>
                    <ComboBoxItem>10</ComboBoxItem>
                </hc:ComboBox>
                <hc:NumericUpDown
                    Margin="2"
                    hc:InfoElement.ContentHeight="27"
                    hc:TitleElement.Title="贪婪度"
                    Increment="5"
                    Maximum="360"
                    Minimum="0"
                    Style="{StaticResource NumericUpDownPlus.Small}"
                    Value="{Binding MathchingService.RunParameter.Greediness}" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
