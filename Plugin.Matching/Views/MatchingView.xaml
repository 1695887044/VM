<UserControl
    x:Class="Plugin.Matching.Views.MatchingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvts="clr-namespace:Plugin.Matching.Converts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dock="clr-namespace:Plugin.Matching.Dock"
    xmlns:halconCt="clr-namespace:VM.Halcon.Controls;assembly=VM.Halcon"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:linkCt="clr-namespace:VM.IPlugin.Controls;assembly=VM.IPlugin"
    xmlns:local="clr-namespace:Plugin.Matching.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="980"
    Height="680"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  定义DataGrid的样式  -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AlternatingRowBackground" Value="#F0F0F0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="BorderBrush" Value="#D0D0D0" />
                        <Setter Property="Padding" Value="5" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="#0078D7" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="BorderBrush" Value="#005EA2" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TabControl Grid.Column="0">
            <TabItem Header="基本参数">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75*" />
                        <ColumnDefinition Width="22*" />
                        <ColumnDefinition Width="201*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <GroupBox Grid.ColumnSpan="3" Header="图像链接">
                        <linkCt:LabelLinkPath
                            Header="图像链接"
                            LinkParam="Img"
                            OperatorCommand="{Binding LabelLinkCommand}"
                            Value="{Binding CurHImage, Mode=TwoWay}" />
                    </GroupBox>
                    <GroupBox
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Header="搜索区域信息">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <UniformGrid
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                Columns="2"
                                Rows="1">
                                <RadioButton
                                    CommandParameter="Null"
                                    Content="全图"
                                    GroupName="Ra1"
                                    IsChecked="True" />
                                <RadioButton
                                    CommandParameter="RegionLink"
                                    Content="🔗链接区域"
                                    GroupName="Ra1"
                                    IsChecked="{Binding UseRoi}" />
                            </UniformGrid>
                            <StackPanel Visibility="{Binding UseRoi,Converter={StaticResource Boolean2VisibilityConverter}}" Grid.Row="1" Orientation="Vertical">
                                <linkCt:LabelLinkPath
                                    
                                    Header="ROI链接"
                                    LinkParam="Roi"
                                    OperatorCommand="{Binding LabelLinkCommand}"
                                    Value="{Binding CurRoi, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="参数设置">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <GroupBox Header="模板设置">
                        <Grid>
                            <halconCt:ImageDisplay HImage="{Binding TemplateImage}" HWindow="{Binding TemplateHWindow, Mode=TwoWay}" />
                        </Grid>
                    </GroupBox>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <RadioButton
                                    Margin="15,5"
                                    Content="形状"
                                    GroupName="ModeRadio"
                                    IsChecked="{Binding MatchType, Converter={cvts:BoolStringConvert}, ConverterParameter=1}"
                                    Style="{StaticResource RadioButtonBaseStyle}" />
                                <RadioButton
                                    Margin="15,5"
                                    Content="灰度"
                                    GroupName="ModeRadio"
                                    IsChecked="{Binding MatchType, Converter={cvts:BoolStringConvert}, ConverterParameter=2}" />
                                <RadioButton
                                    Margin="15,5"
                                    Content="形变"
                                    GroupName="ModeRadio"
                                    IsChecked="{Binding MatchType, Converter={cvts:BoolStringConvert}, ConverterParameter=3}" />
                            </StackPanel>
                            <dock:ShapeParamView Visibility="{Binding MatchType, Converter={cvts:StringVisiBilityConvert}, ConverterParameter=1}" />
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </TabItem>
            <TabItem Header="数据结果">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <GroupBox Header="结果坐标">
                        <StackPanel>
                            <Border Height="30" Background="Green" />
                            <DataGrid ItemsSource="{Binding MathchingService.MatchResults}" IsReadOnly="True" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
        <halconCt:ImageReadOnly
            Grid.Column="1"
            HImage="{Binding CurHImage.Value}"
            HWindow="{Binding HWindow, Mode=OneWayToSource}"
            IsDrawing="{Binding IsDrawing, Mode=TwoWay}"
            TopText="{Binding ViewTopText, Mode=TwoWay}" />
    </Grid>
</UserControl>
